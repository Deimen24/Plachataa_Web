# Copy to .env to override defaults; run.sh / run.ps1 load it.
# PLACHATAA_HOST=127.0.0.1
# PLACHATAA_PORT=7870
# PLACHATAA_DEVICE=auto          # cuda | cpu | auto
# PLACHATAA_DATA_DIR=D:\plachataa-data   # uploads, outputs, model cache
# PLACHATAA_SEEDVC_DIR=vendor/seed-vc
# PLACHATAA_MAX_UPLOAD_MB=200
# HF_ENDPOINT=https://hf-mirror.com     # if huggingface.co is unreachable
