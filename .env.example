# Copy to .env to override defaults. The server, run scripts and the
# service all read this file.

# --- network --------------------------------------------------------------
# PLACHATAA_PORT=7870
# PLACHATAA_HOST=127.0.0.1       # the service always listens on 0.0.0.0
# PLACHATAA_MAX_UPLOAD_MB=200

# --- reverse proxy on another machine ------------------------------------
# PLACHATAA_ROOT_PATH=/voice     # only when served under a sub-path
# PLACHATAA_FORWARDED_ALLOW_IPS=192.168.1.10   # proxy IP, or * for any
# PLACHATAA_BASIC_AUTH=user:password           # if the proxy does not authenticate

# --- paths / hardware -----------------------------------------------------
# PLACHATAA_DEVICE=auto          # cuda | cpu | auto
# PLACHATAA_DATA_DIR=D:\plachataa-data   # uploads, outputs, model cache
# PLACHATAA_SEEDVC_DIR=vendor/seed-vc
# PLACHATAA_LOG_FILE=data/logs/server.log
# HF_ENDPOINT=https://hf-mirror.com     # if huggingface.co is unreachable
